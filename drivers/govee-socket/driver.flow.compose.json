{
    "triggers": [
      {
        "deprecated": true,
        "id": "alarm_online.socket_false",
        "title": {
          "en": "The socket is online"
        },
        "hint": {
          "en": "When the socket is reported online"
        },
        "$filter": "capabilities=alarm_online.socket"
      },
      {
        "deprecated": true,
        "id": "alarm_online.socket_true",
        "title": {
          "en": "The socket is offline"
        },
        "hint": {
          "en": "When the socket is reported to be offline"
        },
        "$filter": "capabilities=alarm_online.socket"
      }
    ],
    "conditions": [
      {
        "id": "nightlightscene-active.socket",
        "title": {
          "en": "A specific nightlight scene is active"
        },
        "titleFormatted": {
          "en": "The nightlight scene [[nightlightScene]] !{{Is|Isn't}} active"
        },
        "hint": {
          "en": "Current active nightlight scene"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "nightlightScene",
            "title": {
              "en": "Nightlight scene"
            },
            "placeholder": {
              "en": "Nightlight scene"
            }
          }
        ],
        "$filter": "capabilities=nightlightScenes.socket"
      }
    ],
    "actions": [
      {
        "id": "activate-nightlight.socket",
        "title": {
          "en": "Toggle the nightlight"
        },
        "titleFormatted": {
          "en": "Activate the nightlight [[activate]]"
        },
        "titleTrue": {
          "en": "Activate nightlight"
        },
        "titleFalse": {
          "en": "Deactivate nightlight"
        },
        "insightsTitleTrue": {
          "en": "Nightlight was activated"
        },
        "insightsTitleTFalse": {
          "en": "Nightlight was deactivated"
        },
        "hint": {
          "en": "Activates or deactivates the nightlight"
        },
        "$filter": "capabilities=nightlightToggle.socket",
        "args": [
          {
            "type": "checkbox",
            "name": "activate",
            "title": {
              "en": "Activate"
            },
            "placeholder": {
              "en": "Activate"
            }
          }
        ]
      },
      {
        "id": "switch-to-nightlight-scene.socket",
        "title": {
          "en": "Switch to light scene"
        },
        "hint": {
          "en": "Switches to the selected nightlight scene"
        },
        "titleFormatted": {
          "en": "Switch to light scene [[nightlightScene]]"
        },
        "$filter": "capabilities=nightlightScenes.socket",
        "args": [
          {
            "type": "autocomplete",
            "name": "nightlightScene",
            "title": {
              "en": "Scene"
            },
            "placeholder": {
              "en": "Forest"
            }
          }
        ]
      },
      {
        "id": "switch-to-random-nightlight-scene.socket",
        "title": {
          "en": "Switch to random light scene"
        },
        "hint": {
          "en": "Switches to a random nightlight scene"
        },
        "titleFormatted": {
          "en": "Switch to random light scene"
        },
        "$filter": "capabilities=nightlightScenes.socket"
      },
      {
        "id": "activate-socketToggle1.socket",
        "title": {
          "en": "Toggle outlet 1"
        },
        "titleFormatted": {
          "en": "Set outlet 1 to [[activate]]"
        },
        "$filter": "capabilities=socketToggle1.socket",
        "args": [
          {
            "type": "checkbox",
            "name": "activate",
            "title": {
              "en": "On"
            }
          }
        ]
      },
      {
        "id": "activate-socketToggle2.socket",
        "title": {
          "en": "Toggle outlet 2"
        },
        "titleFormatted": {
          "en": "Set outlet 2 to [[activate]]"
        },
        "$filter": "capabilities=socketToggle2.socket",
        "args": [
          {
            "type": "checkbox",
            "name": "activate",
            "title": {
              "en": "On"
            }
          }
        ]
      }
    ]
}
